{
  "id": "py-fastapi",
  "language": "python",
  "displayName": "FastAPI + SQLAlchemy",
  "migrationTool": "alembic",
  "commands": {
    "install": "uv sync --all-packages --frozen",
    "lint": "make lint",
    "typecheck": "make types",
    "gate": "make check",
    "test": "make test",
    "test:unit": "uv run pytest tests/unit -q",
    "test:integration": "uv run pytest tests/integration -q",
    "test:e2e": "uv run pytest tests/e2e -q",
    "dev": "make api",
    "db:generate": "uv run alembic revision --autogenerate -m",
    "db:migrate": "uv run alembic upgrade head",
    "db:migrate:test": "uv run alembic upgrade head",
    "deps:update": "uv lock --upgrade-package"
  },
  "paths": {
    "excludeFromConventionChecks": ["tests/", ".venv/", "__pycache__/", "migrations/versions/"],
    "migrations": "apps/api/migrations/versions",
    "sourceExtensions": [".py"]
  },
  "auditChecks": "audit/python",
  "platformCommands": {
    "win32": {
      "lint": "uv run ruff format --check . && uv run ruff check . && uv run python scripts/check_layer_purity.py",
      "typecheck": "uv run pyright",
      "test": "uv run pytest",
      "gate": "uv run ruff format --check . && uv run ruff check . && uv run python scripts/check_layer_purity.py && uv run pyright && uv run pytest",
      "dev": "uv run app-api"
    }
  }
}
